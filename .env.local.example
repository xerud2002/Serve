# SERVE Website - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# EMAIL CONFIGURATION (Resend API)
# ============================================
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# ============================================
# FACEBOOK INTEGRATION
# ============================================
# Get your access token from: https://developers.facebook.com/tools/explorer/
# 
# REQUIRED PERMISSIONS:
# - pages_show_list
# - pages_read_engagement  
# - pages_manage_metadata
# - pages_read_user_content
#
# STEPS TO GET TOKEN:
# 1. Go to https://developers.facebook.com/tools/explorer/
# 2. Select "Serve Website" app (or your app)
# 3. Select "User Token" 
# 4. Add permissions: pages_show_list, pages_events, pages_manage_metadata, pages_read_user_content
# 5. Click "Generate Access Token"
# 6. Copy the token and paste below
# 7. IMPORTANT: This token expires! Update it daily or generate a long-lived token
#
# To generate a LONG-LIVED token (60 days):
# Use this URL (replace YOUR_APP_ID, YOUR_APP_SECRET, and SHORT_TOKEN):
# https://graph.facebook.com/v24.0/oauth/access_token?grant_type=fb_exchange_token&client_id=YOUR_APP_ID&client_secret=YOUR_APP_SECRET&fb_exchange_token=SHORT_TOKEN

FACEBOOK_ACCESS_TOKEN=YOUR_FACEBOOK_ACCESS_TOKEN_HERE
FACEBOOK_PAGE_ID=239416516576684

# ============================================
# NEXT.JS CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=https://serve.org.uk
