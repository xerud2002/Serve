{
  "name": "serve-charity-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:forms": "node scripts/test-forms.js",
    "test:compatibility": "node scripts/test-compatibility.js",
    "test:booking": "node scripts/test-booking-system.js",
    "test:all": "npm run test:forms && npm run test:compatibility && npm run test:booking",
    "audit:performance": "npx --yes lighthouse http://localhost:3000 --output json --output html --output-path ./reports/",
    "deploy:prepare": "npm run lint && npm run build && npm run test:all",
    "deploy:vps": "powershell -ExecutionPolicy Bypass -File ./quick-update-vps.ps1",
    "deploy:vps:skip-checks": "powershell -ExecutionPolicy Bypass -File ./quick-update-vps.ps1 -SkipChecks",
    "deploy:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-github-deploy.ps1"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "lightningcss": "^1.32.0",
    "next": "^16.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.11.37",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.5.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "Chrome >= 87",
      "Firefox >= 78",
      "Safari >= 14",
      "Edge >= 88",
      "iOS >= 14",
      "Android >= 10",
      "Samsung >= 14",
      "Opera >= 75",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
