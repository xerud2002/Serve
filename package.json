{
  "name": "serve-charity-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:forms": "node scripts/test-forms.js",
    "test:compatibility": "node scripts/test-compatibility.js",
    "test:booking": "node scripts/test-booking-system.js",
    "test:all": "npm run test:forms && npm run test:compatibility && npm run test:booking",
    "export": "next build && next export",
    "audit:performance": "lighthouse http://localhost:3000 --output json --output html --output-path ./reports/",
    "deploy:vercel": "vercel --prod",
    "deploy:prepare": "npm run lint && npm run build && npm run test:all",
    "deploy:vps": "powershell -ExecutionPolicy Bypass -File ./deploy-vps.ps1",
    "deploy:vps:skip-tests": "powershell -ExecutionPolicy Bypass -File ./deploy-vps.ps1 -SkipTests"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/nodemailer": "^7.0.11",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "lightningcss": "^1.30.2",
    "next": "^16.2.1",
    "nodemailer": "^8.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.4",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.11",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.1",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "Chrome >= 87",
      "Firefox >= 78",
      "Safari >= 14",
      "Edge >= 88",
      "iOS >= 14",
      "Android >= 10",
      "Samsung >= 14",
      "Opera >= 75",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
