    "lightningcss": "^1.30.2",
    "next": "^16.0.7",
    "next-pwa": "^5.6.0",
    "nodemailer": "^7.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.4.2",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "lighthouse": "^12.8.2",
