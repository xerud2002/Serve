   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Holding hands, caregiver and senior woman in wheelchair for support outdoor in retirement home. Love, trust and healthcare nurse or medical wellness doctor for disability patient with kindness.</rdf:li>
    </rdf:Alt>
   </dc:description>
