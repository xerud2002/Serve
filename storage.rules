rules_version = '2';

// Firebase Storage Security Rules for SERVE Charity
service firebase.storage {
  match /b/{bucket}/o {
    
    // Posts images - Public read for everyone, authenticated write
    match /posts/{allPaths=**} {
      allow read: if true;  // Anyone can view post images (no auth required)
      allow write: if request.auth != null;  // Only authenticated users can upload
      allow delete: if request.auth != null;  // Only authenticated users can delete
    }
    
    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
