    { "source": "/get-involved", "destination": "/volunteer/", "statusCode": 301 },
    { "source": "/get-involved/boards-of-trustees/", "destination": "/volunteer/", "statusCode": 301 },
    { "source": "/get-involved/:path*", "destination": "/volunteer/", "statusCode": 301 },
    { "source": "/serve-voluntary-services/", "destination": "/about/", "statusCode": 301 },
    { "source": "/serve-voluntary-services", "destination": "/about/", "statusCode": 301 },
    { "source": "/community-fundraising/", "destination": "/corporate-fundraising/", "statusCode": 301 },
    { "source": "/community-fundraising", "destination": "/corporate-fundraising/", "statusCode": 301 },
    { "source": "/cookie-policy/", "destination": "/cookies/", "statusCode": 301 },
    { "source": "/cookie-policy", "destination": "/cookies/", "statusCode": 301 },
    { "source": "/privacy-policy/", "destination": "/privacy/", "statusCode": 301 },
